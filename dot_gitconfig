[user]
	name = Filip Krikava
	email = krikava@gmail.com

[init]
	defaultBranch = main

[core]
	autocrlf = input
	# delta for everything paged: diff, log, show, blame, grep...
	pager = delta

[credential]
	helper = osxkeychain

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

# ---------------------------------------------------------------------------
# Diffing
#   git diff      -> delta
#   git ddiff     -> difftastic   (also: git dshow, git dlog)
#   git pdiff     -> plain git diff in less
#   git diffv     -> CodeDiff explorer in Neovim (all changed files)
#   git difftool  -> CodeDiff in Neovim (also lazygit's Ctrl+t)
# ---------------------------------------------------------------------------

[diff]
	tool = codediff
	algorithm = histogram
	colorMoved = default

[difftool]
	prompt = false

[difftool "codediff"]
	cmd = nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff file $LOCAL $REMOTE\"

[interactive]
	diffFilter = delta --color-only --features=interactive

[delta]
	features = decorations
	# n / N jump between hunks
	navigate = true

[delta "interactive"]
	keep-plus-minus-markers = false

[delta "decorations"]
	commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
	hunk-header-style = file line-number syntax

# ---------------------------------------------------------------------------
# Merging
# ---------------------------------------------------------------------------

[merge]
	tool = codediff
	conflictStyle = zdiff3

[mergetool]
	prompt = false
	keepBackup = false

[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff --exit-on-close merge \\\"$MERGED\\\"\"

[rerere]
	enabled = true
	autoUpdate = true

# ---------------------------------------------------------------------------
# Remote / branch behaviour
# ---------------------------------------------------------------------------

[fetch]
	prune = true

[pull]
	rebase = false

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true

[commit]
	verbose = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[help]
	autocorrect = prompt

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------

[pretty]
	compact = "format:%C(bold blue)%h%C(reset) - %C(bold green)(%ah)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)"

[alias]
	lg = !lazygit

	# difftastic / plain variants
	difft = -c diff.external='difft --color=always' -c core.pager=less diff
	dshow = -c diff.external='difft --color=always' -c core.pager=less show --ext-diff
	dlog = -c diff.external='difft --color=always' -c core.pager=less log -p --ext-diff
	pdiff = -c core.pager=less diff
	# CodeDiff explorer in Neovim: git diffv | git diffv main | git diffv main HEAD
	diffv = "!f() { nvim +\"CodeDiff $*\"; }; f"

	# log
	l = log --graph --pretty=compact
	la = log --graph --pretty=compact --all
	ll = log --pretty=compact --stat
	last = log -1 --stat
	incoming = log --pretty=compact HEAD..@{upstream}
	outgoing = log --pretty=compact @{upstream}..HEAD
	hist = log --follow -p --
	find = log --pretty=compact -S
	standup = !git log --pretty=compact --since=yesterday --author=\"$(git config user.email)\"
	who = shortlog -sne --no-merges HEAD

	# stash only untracked files (for staged only, use the built-in: git stash -S)
	stash-untracked = "!git ls-files -z --others --exclude-standard | xargs -0 -r git stash push --include-untracked -m untracked --"
