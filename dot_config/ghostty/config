clipboard-paste-protection = false
confirm-close-surface = false
font-size = 16
macos-option-as-alt = true
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
window-inherit-working-directory = true
window-padding-x = 5
window-padding-y = 5

# custom keys
keybind = super+shift+equal=increase_font_size:1
keybind = super+equal=reset_font_size
keybind = global:super+alt+ctrl+grave_accent=toggle_quick_terminal
keybind = ctrl+escape=reset

keybind = shift+up=unbind
keybind = shift+down=unbind
keybind = shift+left=unbind
keybind = shift+right=unbind
keybind = shift+home=unbind
keybind = shift+end=unbind
keybind = shift+page_up=unbind
